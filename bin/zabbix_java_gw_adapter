#!/usr/bin/env bash

# Talk to local zabbix-java-gateway (port 10052) using the native Zabbix binary protocol.
# Used from zabbix-agent UserParameter (z_java_gw_adapter_lo) for active JMX checks when
# JMX is bound to localhost only (jmxremote.local.only=true).
#
# Reference: https://blog.zabbix.com/new-monitoring-possibilities-for-java-applications-in-zabbix-3-4/5972/
# See also: https://www.zabbix.com/documentation/current/en/manual/concepts/java
#
# Usage: zabbix_java_gw_adapter <host> <jmx_port> <jmx_key> [username] [password]

exec 3<>/dev/tcp/localhost/10052
MSG='{"request":"java gateway jmx"'"${4/#/,username:}${5/#/,password:}"',"jmx_endpoint":"service:jmx:rmi:///jndi/rmi://'"${1}":${2}/'jmxrmi","keys":["'"${3}"'"]}'
printf -v LEN '%016x' "${#MSG}"

BYTES=""
for i in {0..14..2}; do BYTES="\\x${LEN:$i:2}$BYTES"; done

printf "ZBXD\\1$BYTES%s" "$MSG" >&3
tail -c+14 <&3
echo ""
